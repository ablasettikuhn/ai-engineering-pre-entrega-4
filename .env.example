# Copia este archivo como .env y completa tus claves (el .env NO se sube a GitHub)

# --- Claves (obligatorias) ---
PINECONE_API_KEY=tu_clave_de_pinecone
# Gemini reemplaza a OpenAI: genera los embeddings (y la respuesta de consultar.py --responder)
GOOGLE_API_KEY=tu_clave_de_gemini

# --- Pinecone (plan gratuito Starter: solo AWS us-east-1) ---
INDEX_NAME=papers-ciencias-deporte
PINECONE_NAMESPACE=papers-cientificos
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# --- Embeddings (si los cambias, usa otro INDEX_NAME o ejecuta: python ingesta.py --forzar) ---
EMBEDDINGS_MODEL=gemini-embedding-001
EMBEDDINGS_DIM=1536
EMBEDDINGS_TOKENS_POR_MINUTO=25000

# --- Chunking (tokens; la consigna recomienda 500-800) ---
CHUNK_SIZE=700
CHUNK_OVERLAP=100

# --- Recuperación híbrida ---
TOP_K=5
K_CANDIDATOS=10
PESO_BM25=0.4
# Similitud mínima para considerar que hay evidencia (se calibra con python evaluate.py)
UMBRAL_SIMILITUD=0.60

# --- LLM (solo para consultar.py --responder) ---
GEMINI_MODEL=gemini-3.1-flash-lite
